#include <iostream>
using namespace std;

void search(char pat[], char txt[]) {
    int m = 0, n = 0;

    while (pat[m] != '\0')
        m++;

    while (txt[n] != '\0')
        n++;

    int lps[1000];

    lps[0] = 0;

    int len = 0;
    int i = 1;

    while (i < m) {
        if (pat[i] == pat[len]) {
            len++;
            lps[i] = len;
            i++;
        }
        else {
            if (len != 0)
                len = lps[len - 1];
            else {
                lps[i] = 0;
                i++;
            }
        }
    }

    i = 0;
    int j = 0;

    while (i < n) {
        if (txt[i] == pat[j]) {
            i++;
            j++;
        }

        if (j == m) {
            cout << i - j << endl;
            j = lps[j - 1];
        }
        else if (i < n && txt[i] != pat[j]) {
            if (j != 0)
                j = lps[j - 1];
            else
                i++;
        }
    }
}

int main() {
    char txt[1000];
    char pat[1000];

    cin.getline(txt, 1000);
    cin.getline(pat, 1000);

    search(pat, txt);

    return 0;
}
