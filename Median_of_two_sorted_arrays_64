
#include <iostream>
#include <iomanip>
using namespace std;

int main()
{
    int n, m;
    cin >> n >> m;

    int arr1[n], arr2[m];

    for(int i = 0; i < n; i++)
        cin >> arr1[i];

    for(int i = 0; i < m; i++)
        cin >> arr2[i];

    int merged[n + m];

    int i = 0;
    int j = 0;
    int k = 0;
    while(i < n && j < m)
    {
        if(arr1[i] <= arr2[j])
        {
            merged[k] = arr1[i];
            i++;
        }
        else
        {
            merged[k] = arr2[j];
            j++;
        }

        k++;
    }

    while(i < n)
    {
        merged[k] = arr1[i];
        i++;
        k++;
    }

    while(j < m)
    {
        merged[k] = arr2[j];
        j++;
        k++;
    }

    int total = n + m;

    cout << fixed << setprecision(1);

    if(total % 2 == 1)
    {

        cout << (double)merged[total / 2];
    }
    else
    {
        double median =
            (merged[total / 2 - 1] + merged[total / 2]) / 2.0;

        cout << median;
    }

    return 0;
}
