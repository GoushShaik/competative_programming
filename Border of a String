#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;


int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */ 
    string s;
    cin >> s;

    int n = s.length();

    for (int len = n - 1; len >= 1; len--) {
        string prefix = s.substr(0, len);
        string suffix = s.substr(n - len, len);


        if (prefix == suffix) {
            cout << prefix;
            return 0;
        }
    }

    return 0;
}  
