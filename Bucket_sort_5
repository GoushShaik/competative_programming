
#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main()
{
    int N;
    cin >> N;

    vector<double> arr(N);

    for(int i = 0; i < N; i++)
    {
        cin >> arr[i];
    }

    vector<vector<double>> buckets(N);

    double minValue = arr[0];
    double maxValue = arr[0];

    for(int i = 1; i < N; i++)
    {
        minValue = min(minValue, arr[i]);
        maxValue = max(maxValue, arr[i]);
    }

  
    for(int i = 0; i < N; i++)
    {
        int index;

        if(maxValue == minValue)
        {
            index = 0;
        }
        else
        {
            index = (int)((arr[i] - minValue) / 
                          (maxValue - minValue) * N);

            if(index == N)
                index = N - 1;
        }

        buckets[index].push_back(arr[i]);
    }

    for(int i = 0; i < N; i++)
    {
        sort(buckets[i].begin(), buckets[i].end());
    }
 for(int i = 0; i < N; i++)
    {
        for(int j = 0; j < buckets[i].size(); j++)
        {
        
            if(arr[0] >= 1)
                cout << (long long)buckets[i][j];
            else
                cout << fixed << setprecision(2) << buckets[i][j];

            if(i != N - 1 || j != buckets[i].size() - 1)
                cout << " ";
        }
    }

    return 0;
}

