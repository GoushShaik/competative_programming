#include <bits/stdc++.h>
using namespace std;

int main() {
    int R, C;
    cin >> R >> C;

    int a[500][500];
    int dp[500][500];

    for (int i = 0; i < R; i++) {
        for (int j = 0; j < C; j++) {
            cin >> a[i][j];
        }
    }

    dp[0][0] = a[0][0];

    for (int j = 1; j < C; j++)
        dp[0][j] = dp[0][j - 1] + a[0][j];

    for (int i = 1; i < R; i++)
        dp[i][0] = dp[i - 1][0] + a[i][0];

    for (int i = 1; i < R; i++) {
        for (int j = 1; j < C; j++) {

            int minimum = dp[i - 1][j];

            if (dp[i][j - 1] < minimum)
                minimum = dp[i][j - 1];

            if (dp[i - 1][j - 1] < minimum)
                minimum = dp[i - 1][j - 1];

            dp[i][j] = a[i][j] + minimum;
        }
    }

    cout << dp[R - 1][C - 1];

    return 0;
}
