#include <iostream>
using namespace std;

int main() {
    string s;
    cin >> s;

    int n = s.length();

    for (int p = 1; p <= n; p++) {
        if (n % p != 0)
            continue;

        bool valid = true;

        for (int i = 0; i < n; i++) {
            if (s[i] != s[i % p]) {
                valid = false;
                break;
            }
        }

        if (valid) {
            cout << p;
            break;
        }
    }

    return 0;
}
