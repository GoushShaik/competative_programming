#include <iostream>
#include <cmath>
using namespace std;

int a[30], n, total, ans = 1000000000;

void solve(int i, int count, int sum) {
    if (i == n) {
        if (abs(count - (n - count)) <= 1) {
            int diff = abs(sum - (total - sum));
            ans = min(ans, diff);
        }
        return;
    }

    solve(i + 1, count + 1, sum + a[i]);
    solve(i + 1, count, sum);
}

int main() {
    cin >> n;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }

    solve(0, 0, 0);

    cout << ans;

    return 0;
}
