#include <bits/stdc++.h>
using namespace std;

int main() {
    string s, p;
    cin >> s >> p;

    int i = 0, j = 0;
    int star = -1;
    int match = 0;

    while (i < s.length()) {

        if (j < p.length() && (p[j] == '?' || p[j] == s[i])) {
            i++;
            j++;
        }
        else if (j < p.length() && p[j] == '*') {
            star = j;
            match = i;
            j++;
        }
        else if (star != -1) {
            j = star + 1;
            match++;
            i = match;
        }
        else {
            cout << 0;
            return 0;
        }
    }

    while (j < p.length() && p[j] == '*')
        j++;

    if (j == p.length())
        cout << 1;
    else
        cout << 0;

    return 0;
}
