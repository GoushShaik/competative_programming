#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    string dict[100];
    
    string line;
    cin >> line;

    int j = 0;
    string word = "";

    for (char ch : line) {
        if (ch == ',') {
            dict[j] = word;
            j++;
            word = "";
        }
        else {
            word = word + ch;
        }
    }

    dict[j] = word;

    string pattern;
    cin >> pattern;

    bool found = false;

    for (int i = 0; i < n; i++) {
        string abbrevation = "";

        for (char ch : dict[i]) {
            if (ch >= 'A' && ch <= 'Z') {
                abbrevation = abbrevation + ch;
            }
        }

        if (abbrevation.substr(0, pattern.length()) == pattern) {
            cout << dict[i] << endl;
            found = true;
        }
    }

    if (!found) {
        cout << "No match found";
    }

    return 0;
}
