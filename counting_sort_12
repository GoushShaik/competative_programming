#include <iostream>
using namespace std;

int main()
{
    int n;
    cin >> n;

    int freq[100] = {0};

    for(int i = 0; i < n; i++)
    {
        int x;
        cin >> x;
        freq[x]++;
    }

    for(int i = 0; i < 100; i++)
    {
        for(int j = 0; j < freq[i]; j++)
        {
            cout << i << " ";
        }
    }

    return 0;
}
