#include <bits/stdc++.h>
using namespace std;

int main() {
    int V, N;
    cin >> V >> N;

    vector<int> coin(N);

    for (int i = 0; i < N; i++)
        cin >> coin[i];

    vector<int> dp(V + 1, V + 1);

    dp[0] = 0;

    for (int i = 1; i <= V; i++) {
        for (int j = 0; j < N; j++) {
            if (coin[j] <= i) {
                dp[i] = min(dp[i], dp[i - coin[j]] + 1);
            }
        }
    }

    if (dp[V] == V + 1)
        cout << -1;
    else
        cout << dp[V];

    return 0;
}
