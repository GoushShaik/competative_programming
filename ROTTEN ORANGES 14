#include <bits/stdc++.h>
using namespace std;

int main() {
    int N, M;
    cin >> N >> M;

    int grid[500][500];
    int qx[250000], qy[250000];

    int front = 0, rear = 0;
    int fresh = 0;

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            cin >> grid[i][j];

            if (grid[i][j] == 2) {
                qx[rear] = i;
                qy[rear] = j;
                rear++;
            }

            if (grid[i][j] == 1)
                fresh++;
        }
    }

    int time = 0;

    int dx[4] = {-1, 1, 0, 0};
    int dy[4] = {0, 0, -1, 1};

    while (front < rear) {

        int size = rear - front;

        for (int k = 0; k < size; k++) {
            int x = qx[front];
            int y = qy[front];
            front++;

            for (int d = 0; d < 4; d++) {
                int nx = x + dx[d];
                int ny = y + dy[d];

                if (nx >= 0 && nx < N &&
                    ny >= 0 && ny < M &&
                    grid[nx][ny] == 1) {

                    grid[nx][ny] = 2;
                    fresh--;

                    qx[rear] = nx;
                    qy[rear] = ny;
                    rear++;
                }
            }
        }

        if (front < rear)
            time++;
    }

    if (fresh > 0)
        cout << -1;
    else
        cout << time;

    return 0;
}
