#include <iostream>
using namespace std;

struct Node {
    Node* child[26];
    bool end;
};

Node* createNode() {
    Node* p = new Node();

    for (int i = 0; i < 26; i++)
        p->child[i] = NULL;

    p->end = false;

    return p;
}

void insert(Node* root, string word) {
    Node* p = root;

    for (int i = 0; i < word.length(); i++) {
        int x = word[i] - 'a';

        if (p->child[x] == NULL)
            p->child[x] = createNode();

        p = p->child[x];
    }

    p->end = true;
}

bool search(Node* root, string word) {
    Node* p = root;

    for (int i = 0; i < word.length(); i++) {
        int x = word[i] - 'a';

        if (p->child[x] == NULL)
            return false;

        p = p->child[x];
    }

    return p->end;
}

int main() {
    int n;
    cin >> n;
    cin.ignore();

    Node* root = createNode();

    string line;
    getline(cin, line);

    string word = "";

    for (int i = 0; i <= line.length(); i++) {

        if (line[i] == ',' || line[i] == '\0') {
            insert(root, word);
            word = "";
        }
        else {
            word = word + line[i];
        }
    }

    string target;
    cin >> target;

    if (search(root, target))
        cout << 1;
    else
        cout << 0;

    return 0;
}
