#include <iostream>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;

    int a[1000][1000];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> a[i][j];
        }
    }

    int top = 0, bottom = n - 1;
    int left = 0, right = m - 1;

    while (top <= bottom && left <= right) {

        // Left to Right
        for (int j = left; j <= right; j++)
            cout << a[top][j] << " ";
        top++;

        // Top to Bottom
        for (int i = top; i <= bottom; i++)
            cout << a[i][right] << " ";
        right--;

        // Right to Left
        if (top <= bottom) {
            for (int j = right; j >= left; j--)
                cout << a[bottom][j] << " ";
            bottom--;
        }

        // Bottom to Top
        if (left <= right) {
            for (int i = bottom; i >= top; i--)
                cout << a[i][left] << " ";
            left++;
        }
    }

    return 0;
}
